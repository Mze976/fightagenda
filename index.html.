
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#121923">
<meta name="description" content="Calendrier des sports de combat diffusés en France.">
<title>FightAgenda — Calendrier des combats</title>

<style>
:root{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color-scheme:dark;--bg:#0d1219;--panel:#151d28;--panel2:#202b39;--line:#2c3949;--text:#f5f7fa;--muted:#aab5c3;--accent:#ef563e}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text)}
button,input,select,textarea{font:inherit}
button,a{cursor:pointer}
a{color:#ff907e;text-decoration:none}
.top{padding:16px 22px;background:#17212e;border-bottom:1px solid var(--line)}
.brand{font-weight:950;font-size:22px}
.brand span{color:var(--accent)}
.brand small{display:block;font-size:9px;letter-spacing:.18em;color:var(--muted)}
.hero{padding:30px 22px;background:linear-gradient(115deg,#1b2939,#18212d)}
.eyebrow{font-size:11px;color:#ff9b89;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
.hero h1{font-size:clamp(28px,5vw,44px);line-height:1.05;margin:12px 0}
.hero p{max-width:720px;color:#c0cad5;line-height:1.55}
.wrap{max-width:1100px;margin:auto;padding:22px 16px 45px}
.toolbar,.adminhead{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.toolbar h2,.admin h2{margin:0}
.muted{color:var(--muted);font-size:12px}
.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px;margin:15px 0}
.field label{display:block;font-size:10px;font-weight:850;color:var(--muted);margin-bottom:6px}
.field input,.field select,.field textarea{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:11px;color:var(--text);min-width:0}
.btn,.tab{border:1px solid var(--line);border-radius:9px;padding:9px 12px;background:var(--panel);color:var(--text);font-weight:750;font-size:12px}
.btn.primary,.tab.active{background:var(--accent);border-color:var(--accent);color:white}
.btn.danger{border-color:#8e3e3a;color:#ff9b89}
.btn:disabled{opacity:.45;cursor:wait}
.tabs,.btnrow{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}
.events{display:grid;gap:11px}
.event{display:grid;grid-template-columns:72px minmax(0,1fr) 150px;gap:12px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:13px}
.datebox{text-align:center;border-radius:10px;background:var(--panel2);padding:10px 4px}
.datebox b{font-size:25px;display:block}
.datebox span{font-size:10px;color:var(--muted);text-transform:uppercase}
.kind{font-size:10px;color:#ff907e;font-weight:900;text-transform:uppercase}
.event h3{font-size:16px;margin:5px 0}
.sub{font-size:12px;color:var(--muted);line-height:1.5;overflow-wrap:anywhere}
.chip{display:inline-block;font-size:10px;padding:4px 7px;background:var(--panel2);border-radius:6px;color:var(--muted);margin:6px 4px 0 0}
.broadcast{text-align:right;font-size:12px;overflow-wrap:anywhere}
.broadcast strong{display:block;margin-bottom:6px}
.empty{padding:26px;text-align:center;border:1px dashed var(--line);border-radius:12px;color:var(--muted)}
.panel,.admin{margin-top:22px;border:1px solid var(--line);background:var(--panel);border-radius:14px;padding:16px}
.admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.full{grid-column:1/-1}
.admin textarea{min-height:75px}
.loginbox{max-width:650px;margin-top:14px}
.admin-list{display:grid;gap:8px;margin-top:12px}
.admin-row{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;border:1px solid var(--line);border-radius:10px;padding:10px}
.admin-row small{display:block;color:var(--muted);font-size:10px;margin-top:3px}
.rowbuttons{display:flex;gap:6px;flex-wrap:wrap}
.hidden{display:none!important}
.status{font-size:12px;margin-top:10px;white-space:pre-wrap;overflow-wrap:anywhere;color:var(--muted)}
.status.error{color:#ff9b89}
.status.ok{color:#80e2b8}
.notice{font-size:11px;line-height:1.55;padding:10px;background:#ef563e12;border:1px solid #ef563e45;border-radius:9px;margin-top:10px}
.footer{text-align:center;border-top:1px solid var(--line);padding:20px;color:var(--muted);font-size:11px}
@media(max-width:700px){
.filters{grid-template-columns:1fr 1fr}
.filters .field:first-child{grid-column:1/-1}
.event{grid-template-columns:60px minmax(0,1fr);gap:9px}
.broadcast{grid-column:2;text-align:left;border-top:1px solid var(--line);padding-top:8px}
.admin-grid{grid-template-columns:1fr}
.full{grid-column:auto}
}
</style>
</head>

<body>
<header class="top">
  <div class="brand">FIGHT<span>AGENDA</span>
    <small>LE CALENDRIER DES COMBATS</small>
  </div>
</header>

<section class="hero">
  <div class="eyebrow">L'agenda des sports de combat</div>
  <h1>Tous les combats.<br>Un seul agenda.</h1>
  <p>Les grands événements professionnels de boxe, MMA et sports pieds-poings. Retrouvez les dates, horaires français, diffuseurs et sources de vérification.</p>
</section>

<main class="wrap">
  <div class="toolbar">
    <div>
      <h2>Événements à venir</h2>
      <div class="muted" id="summary">Connexion au calendrier…</div>
    </div>
    <button class="btn" id="reload" type="button">↻ Actualiser</button>
  </div>

  <div class="filters">
    <div class="field">
      <label for="q">RECHERCHE</label>
      <input id="q" placeholder="Événement, combattant, organisation…">
    </div>
    <div class="field">
      <label for="discipline">DISCIPLINE</label>
      <select id="discipline">
        <option value="">Toutes</option>
        <option>Boxe anglaise</option>
        <option>MMA</option>
        <option>Kick-boxing</option>
        <option>Muay-thaï</option>
        <option>Judo</option>
        <option>Lutte</option>
      </select>
    </div>
    <div class="field">
      <label for="period">PÉRIODE</label>
      <select id="period">
        <option value="all">Toutes les dates</option>
        <option value="7">7 prochains jours</option>
        <option value="30">30 prochains jours</option>
        <option value="90">90 prochains jours</option>
      </select>
    </div>
  </div>

  <div class="tabs">
    <button class="tab active" data-tab="all" type="button">Tous</button>
    <button class="tab" data-tab="week" type="button">Cette semaine</button>
    <button class="tab" data-tab="boxing" type="button">Boxe</button>
    <button class="tab" data-tab="mma" type="button">MMA</button>
    <button class="tab" data-tab="pending" type="button">Diffusion à confirmer</button>
  </div>

  <div id="events" class="events">
    <div class="empty">Chargement du calendrier…</div>
  </div>

  <div class="panel">
    <h3>Sources officielles</h3>
    <p>
      <a href="https://www.ufc.com/events" target="_blank" rel="noopener noreferrer">UFC</a> ·
      <a href="https://pflmma.com/" target="_blank" rel="noopener noreferrer">PFL</a> ·
      <a href="https://www.matchroomboxing.com/" target="_blank" rel="noopener noreferrer">Matchroom Boxing</a> ·
      <a href="https://queensberry.co.uk/" target="_blank" rel="noopener noreferrer">Queensberry</a> ·
      <a href="https://www.dazn.com/" target="_blank" rel="noopener noreferrer">DAZN</a> ·
      <a href="https://rmcsport.bfmtv.com/" target="_blank" rel="noopener noreferrer">RMC Sport</a>
    </p>
    <div class="notice">Les horaires et diffuseurs doivent être vérifiés à partir de sources officielles. Aucun événement n'est inventé.</div>
    <div class="muted" id="syncInfo">Connexion Supabase en cours…</div>
  </div>

  <section class="admin">
    <div class="adminhead">
      <div>
        <h2>Administration</h2>
        <div class="muted">Connecte-toi pour gérer le calendrier.</div>
      </div>
      <button class="btn" id="adminToggle" type="button" aria-expanded="false" aria-controls="login">Ouvrir la connexion</button>
    </div>

    <div id="login" class="loginbox hidden">
      <div class="admin-grid">
        <div class="field">
          <label for="email">EMAIL ADMINISTRATEUR</label>
          <input id="email" type="email" autocomplete="username" placeholder="Adresse e-mail">
        </div>
        <div class="field">
          <label for="password">MOT DE PASSE</label>
          <input id="password" type="password" autocomplete="current-password" placeholder="Mot de passe">
        </div>
      </div>
      <div class="btnrow">
        <button class="btn primary" id="loginBtn" type="button">Se connecter</button>
        <button class="btn hidden" id="logoutBtn" type="button">Se déconnecter</button>
      </div>
      <div class="muted">Le mot de passe n'est jamais stocké dans ce fichier.</div>
    </div>

    <div id="adminPanel" class="hidden">
      <h3>Ajouter un événement</h3>
      <div class="notice">Un événement en brouillon n'est pas visible par les visiteurs. Vérifie les informations avant de le publier.</div>

      <div class="admin-grid">
        <div class="field">
          <label for="evName">NOM DE L'ÉVÉNEMENT</label>
          <input id="evName" placeholder="Nom officiel">
        </div>
        <div class="field">
          <label for="evDiscipline">DISCIPLINE</label>
          <select id="evDiscipline">
            <option>Boxe anglaise</option>
            <option>MMA</option>
            <option>Kick-boxing</option>
            <option>Muay-thaï</option>
            <option>Judo</option>
            <option>Lutte</option>
          </select>
        </div>
        <div class="field">
          <label for="evDate">DATE ET HEURE DE PARIS</label>
          <input id="evDate" type="datetime-local">
        </div>
        <div class="field">
          <label for="evDetails">ORGANISATION / COMBATTANTS</label>
          <input id="evDetails" placeholder="Affiche ou organisation">
        </div>
        <div class="field">
          <label for="evChannel">DIFFUSEUR FRANÇAIS</label>
          <input id="evChannel" placeholder="À confirmer si inconnu">
        </div>
        <div class="field">
          <label for="evStatus">STATUT DE DIFFUSION</label>
          <select id="evStatus">
            <option value="unconfirmed">À confirmer</option>
            <option value="confirmed">Confirmée</option>
            <option value="provisional">Provisoire</option>
          </select>
        </div>
        <div class="field">
          <label for="evPublication">PUBLICATION</label>
          <select id="evPublication">
            <option value="draft">Brouillon — non visible</option>
            <option value="published">Publié — visible du public</option>
          </select>
        </div>
        <div class="field">
          <label for="evTimeStatus">FIABILITÉ DE L'HORAIRE</label>
          <select id="evTimeStatus">
            <option value="unknown">À vérifier</option>
            <option value="confirmed">Confirmé</option>
            <option value="estimated">Estimé</option>
          </select>
        </div>
        <div class="field full">
          <label for="evSource">URL DE SOURCE OFFICIELLE</label>
          <input id="evSource" type="url" placeholder="https://…">
        </div>
        <div class="field full">
          <label for="evNotes">NOTES</label>
          <textarea id="evNotes" placeholder="Informations complémentaires"></textarea>
        </div>
      </div>

      <div class="btnrow">
        <button class="btn primary" id="saveEvent" type="button">Enregistrer l'événement</button>
        <button class="btn" id="export" type="button">Exporter JSON</button>
      </div>

      <div id="adminStatus" class="status" role="status" aria-live="polite"></div>
      <h3>Événements administrés</h3>
      <div id="adminList" class="admin-list"></div>
    </div>
  </section>
</main>

<footer class="footer">FightAgenda · Calendrier indicatif · Vérifier les droits TV selon le pays et l'événement.</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="./config.js"></script>

<script>
(function(){
'use strict';

const $ = id => document.getElementById(id);
let catalog = [];
let activeTab = 'all';
let sb = null;
let user = null;
let isAdmin = false;
let loading = false;

function esc(v){
  return String(v ?? '').replace(/[&<>"']/g, c => ({
    '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
  }[c]));
}

function setStatus(message, kind=''){
  $('adminStatus').textContent = message;
  $('adminStatus').className = 'status ' + kind;
}

function setSync(message){
  $('syncInfo').textContent = message;
}

function dateInfo(value){
  const d = new Date(value);
  if(Number.isNaN(d.getTime())){
    return {day:'--',month:'Date',weekday:'',full:'Date inconnue',time:'--:--'};
  }
  return {
    day:d.toLocaleDateString('fr-FR',{day:'2-digit',timeZone:'Europe/Paris'}),
    month:d.toLocaleDateString('fr-FR',{month:'short',timeZone:'Europe/Paris'}),
    weekday:d.toLocaleDateString('fr-FR',{weekday:'short',timeZone:'Europe/Paris'}),
    full:d.toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Paris'}),
    time:d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit',timeZone:'Europe/Paris'})
  };
}

function broadcastLabel(s){
  if(s === 'confirmed') return 'Diffusion confirmée';
  if(s === 'provisional') return 'Information provisoire';
  return 'Diffusion à confirmer';
}

function publicationLabel(s){
  if(s === 'published') return 'Publié';
  if(s === 'cancelled') return 'Annulé';
  if(s === 'archived') return 'Archivé';
  return 'Brouillon';
}

function safeUrl(value){
  try{
    const u = new URL(value);
    return ['https:','http:'].includes(u.protocol) ? u.href : '#';
  }catch{
    return '#';
  }
}

/*
 * Le catalogue public affiche exclusivement les événements publiés.
 * La base Supabase applique également la protection RLS.
 */
function render(){
  const q = $('q').value.trim().toLowerCase();
  const disc = $('discipline').value;
  const period = $('period').value;
  const now = new Date();

  const publicCatalog = catalog.filter(e => e.publicationStatus === 'published');

  const list = publicCatalog.filter(e => {
    const hay = [e.name,e.discipline,e.details,e.channel,e.notes].join(' ').toLowerCase();
    if(q && !hay.includes(q)) return false;
    if(disc && e.discipline !== disc) return false;

    const d = new Date(e.start);
    if(Number.isNaN(d.getTime())) return false;

    if(period !== 'all' &&
       (d < now || d > new Date(now.getTime() + Number(period)*86400000))) return false;

    if(activeTab === 'week' &&
       (d < now || d > new Date(now.getTime() + 7*86400000))) return false;

    if(activeTab === 'boxing' && e.discipline !== 'Boxe anglaise') return false;
    if(activeTab === 'mma' && e.discipline !== 'MMA') return false;
    if(activeTab === 'pending' && e.broadcastStatus === 'confirmed') return false;

    return true;
  }).sort((a,b) => new Date(a.start) - new Date(b.start));

  $('events').innerHTML = list.length ? list.map(e => {
    const d = dateInfo(e.start);
    const source = e.source ? safeUrl(e.source) : '#';
    const sourceLink = source !== '#'
      ? `<a href="${esc(source)}" target="_blank" rel="noopener noreferrer">Source ↗</a>`
      : '<span class="muted">Source manquante</span>';

    return `
      <article class="event">
        <div class="datebox">
          <span>${esc(d.month)}</span>
          <b>${esc(d.day)}</b>
          <span>${esc(d.weekday)}</span>
        </div>
        <div>
          <div class="kind">${esc(e.discipline || 'Sport de combat')}</div>
          <h3>${esc(e.name)}</h3>
          <div class="sub">${esc(e.details || 'Détails non renseignés')}<br>${esc(e.notes || '')}</div>
          <span class="chip">${esc(broadcastLabel(e.broadcastStatus))}</span>
          <span class="chip">${esc(d.full)}</span>
          <span class="chip">${esc(e.timeStatus === 'confirmed' ? 'Horaire confirmé' : e.timeStatus === 'estimated' ? 'Horaire estimé' : 'Horaire à vérifier')}</span>
        </div>
        <div class="broadcast">
          <strong>📺 ${esc(e.channel || 'À confirmer')}</strong>
          <div class="muted">${d.time === '00:00' ? 'Heure à confirmer' : 'Début : ' + esc(d.time) + ' (Paris)'}</div>
          ${sourceLink}
        </div>
      </article>`;
  }).join('') : '<div class="empty">Aucun événement publié ne correspond à ces filtres.</div>';

  $('summary').textContent =
    `${publicCatalog.length} événement(s) publié(s) · ${list.length} affiché(s)`;
}

/*
 * L'administration reçoit toutes les lignes autorisées par RLS.
 * Seuls les administrateurs autorisés par la base peuvent modifier.
 */
function renderAdmin(){
  const logged = !!user && isAdmin;
  $('adminPanel').classList.toggle('hidden', !logged);
  $('login').classList.toggle('hidden', !!user);

  $('adminToggle').textContent = user
    ? (isAdmin ? 'Administration connectée' : 'Compte non administrateur')
    : ($('login').classList.contains('hidden') ? 'Ouvrir la connexion' : 'Fermer la connexion');

  $('adminToggle').setAttribute(
    'aria-expanded',
    String(!$('login').classList.contains('hidden'))
  );

  $('logoutBtn').classList.toggle('hidden', !user);

  if(!logged) return;

  $('adminList').innerHTML = catalog.map(e => {
    const status = e.publicationStatus || 'draft';
    const nextStatus = status === 'published' ? 'draft' : 'published';
    const buttonLabel = nextStatus === 'published' ? 'Publier' : 'Mettre en brouillon';

    return `
      <div class="admin-row">
        <div>
          <b>${esc(e.name)}</b>
          <small>${esc(e.discipline)} · ${esc(e.start)} · ${esc(publicationLabel(status))}</small>
          <small>Diffusion : ${esc(broadcastLabel(e.broadcastStatus))}</small>
        </div>
        <div class="rowbuttons">
          <button class="btn" type="button" data-toggle-pub="${esc(e.id)}" data-next-status="${esc(nextStatus)}">${buttonLabel}</button>
          <button class="btn danger" type="button" data-delete="${esc(e.id)}">Supprimer</button>
        </div>
      </div>`;
  }).join('') || '<div class="muted">Aucun événement dans la base.</div>';
}

function mapRow(r){
  return {
    id:r.id,
    name:r.name || '',
    discipline:r.discipline || '',
    start:r.start_at,
    details:r.details || '',
    channel:r.channel || 'À confirmer',
    broadcastStatus:r.broadcast_status || 'unconfirmed',
    publicationStatus:r.status || 'draft',
    timeStatus:r.time_status || 'unknown',
    source:r.source_url || '',
    notes:r.notes || ''
  };
}

async function connect(){
  const cfg = window.FIGHTAGENDA_CONFIG;

  if(!cfg || !cfg.url || !cfg.anonKey){
    setSync('Configuration absente : vérifie config.js, notamment url et anonKey.');
    return false;
  }

  if(!window.supabase || typeof window.supabase.createClient !== 'function'){
    setSync('La bibliothèque Supabase ne s’est pas chargée. Vérifie la connexion Internet.');
    return false;
  }

  try{
    sb = window.supabase.createClient(cfg.url, cfg.anonKey);
    return true;
  }catch(e){
    setSync('Initialisation Supabase impossible : ' + e.message);
    return false;
  }
}

async function fetchRemote(){
  if(!sb || loading) return;
  loading = true;
  $('reload').disabled = true;

  try{
    /*
     * Pas de cache local : le résultat provient de Supabase.
     * RLS limite les lignes visibles selon le compte connecté.
     */
    const {data,error} = await sb
      .from('events')
      .select('id,name,discipline,start_at,details,channel,broadcast_status,source_url,notes,status,time_status')
      .order('start_at',{ascending:true});

    if(error) throw error;

    catalog = (data || []).map(mapRow);
    render();
    renderAdmin();
    setSync('Catalogue synchronisé avec Supabase.');
  }catch(e){
    setSync('Erreur de synchronisation Supabase : ' + e.message);
    $('events').innerHTML =
      '<div class="empty">Impossible de charger le calendrier. Réessaie avec le bouton Actualiser.</div>';
    $('summary').textContent = 'Calendrier indisponible';
  }finally{
    loading = false;
    $('reload').disabled = false;
  }
}

async function checkAdmin(){
  if(!sb || !user){
    isAdmin = false;
    return false;
  }

  try{
    const {data,error} = await sb
      .from('admins')
      .select('user_id')
      .eq('user_id',user.id)
      .maybeSingle();

    if(error) throw error;
    isAdmin = !!data;
  }catch(e){
    isAdmin = false;
    setStatus('Vérification des droits administrateur impossible : ' + e.message,'error');
  }

  return isAdmin;
}

async function onSessionChanged(session){
  user = session ? session.user : null;
  isAdmin = false;

  if(user) await checkAdmin();

  renderAdmin();
  await fetchRemote();

  if(user && !isAdmin){
    setStatus('Ce compte est connecté, mais il ne figure pas dans la liste des administrateurs.','error');
  }
}

async function init(){
  render();

  const ok = await connect();
  if(!ok) return;

  try{
    const {data,error} = await sb.auth.getSession();
    if(error) throw error;

    user = data.session ? data.session.user : null;
    if(user) await checkAdmin();

    renderAdmin();
    await fetchRemote();

    sb.auth.onAuthStateChange((_event,session) => {
      /*
       * Évite d'effectuer des appels Supabase complexes dans le rappel
       * immédiat d'authentification.
       */
      Promise.resolve().then(() => onSessionChanged(session));
    });
  }catch(e){
    setSync('Erreur au démarrage de Supabase : ' + e.message);
  }
}

/* Ouverture et fermeture du formulaire de connexion. */
$('adminToggle').addEventListener('click',() => {
  if(user){
    if(isAdmin) renderAdmin();
    else setStatus('Le compte connecté ne dispose pas des droits administrateur.','error');
    return;
  }

  const login = $('login');
  const opening = login.classList.contains('hidden');
  login.classList.toggle('hidden',!opening);
  $('adminToggle').textContent = opening ? 'Fermer la connexion' : 'Ouvrir la connexion';
  $('adminToggle').setAttribute('aria-expanded',String(opening));

  if(opening) $('email').focus();
});

/* Connexion Supabase. */
$('loginBtn').addEventListener('click',async() => {
  if(!sb){
    setStatus('Connexion impossible : vérifie config.js et le chargement de Supabase.','error');
    return;
  }

  const email = $('email').value.trim();
  const password = $('password').value;

  if(!email || !password){
    setStatus('Saisis ton e-mail et ton mot de passe.','error');
    return;
  }

  $('loginBtn').disabled = true;

  try{
    const {data,error} = await sb.auth.signInWithPassword({email,password});
    if(error) throw error;

    user = data.user;
    await checkAdmin();
    renderAdmin();
    await fetchRemote();

    if(isAdmin){
      setStatus('Connexion administrateur réussie.','ok');
    }else{
      setStatus('Compte connecté, mais non autorisé à administrer FightAgenda.','error');
    }
  }catch(e){
    setStatus('Connexion refusée : ' + e.message,'error');
  }finally{
    $('loginBtn').disabled = false;
  }
});

$('password').addEventListener('keydown',e => {
  if(e.key === 'Enter') $('loginBtn').click();
});
$('email').addEventListener('keydown',e => {
  if(e.key === 'Enter') $('loginBtn').click();
});

/* Déconnexion. */
$('logoutBtn').addEventListener('click',async() => {
  try{
    if(sb){
      const {error} = await sb.auth.signOut();
      if(error) throw error;
    }

    user = null;
    isAdmin = false;
    renderAdmin();
    await fetchRemote();
    setStatus('Session fermée.','ok');
  }catch(e){
    setStatus('Erreur de déconnexion : ' + e.message,'error');
  }
});

/* Ajouter un événement. */
$('saveEvent').addEventListener('click',async() => {
  if(!user || !isAdmin || !sb){
    setStatus('Connecte-toi avec un compte administrateur.','error');
    return;
  }

  const name = $('evName').value.trim();
  const date = $('evDate').value;
  const source = $('evSource').value.trim();

  if(!name || !date){
    setStatus('Le nom et la date sont obligatoires.','error');
    return;
  }

  if(source && safeUrl(source) === '#'){
    setStatus('La source doit être une URL HTTP(S) valide.','error');
    return;
  }

  const parsedDate = new Date(date);
  if(Number.isNaN(parsedDate.getTime())){
    setStatus('La date saisie est invalide.','error');
    return;
  }

  const row = {
    name,
    discipline:$('evDiscipline').value,
    start_at:parsedDate.toISOString(),
    details:$('evDetails').value.trim(),
    channel:$('evChannel').value.trim() || 'À confirmer',
    broadcast_status:$('evStatus').value,
    status:$('evPublication').value,
    time_status:$('evTimeStatus').value,
    source_url:source || null,
    notes:$('evNotes').value.trim()
  };

  $('saveEvent').disabled = true;

  try{
    const {error} = await sb.from('events').insert(row);
    if(error) throw error;

    await fetchRemote();
    setStatus('Événement enregistré. Publication : ' + publicationLabel(row.status) + '.','ok');

    ['evName','evDate','evDetails','evChannel','evSource','evNotes'].forEach(id => {
      $(id).value = '';
    });

    $('evPublication').value = 'draft';
    $('evTimeStatus').value = 'unknown';
    $('evStatus').value = 'unconfirmed';
  }catch(e){
    setStatus('Erreur de sauvegarde : ' + e.message,'error');
  }finally{
    $('saveEvent').disabled = false;
  }
});

/* Publier ou remettre un événement en brouillon. */
$('adminList').addEventListener('click',async ev => {
  const b = ev.target.closest('[data-toggle-pub]');
  if(!b || !user || !isAdmin || !sb) return;

  const id = b.dataset.togglePub;
  const nextStatus = b.dataset.nextStatus;

  if(!['draft','published'].includes(nextStatus)) return;

  const action = nextStatus === 'published' ? 'publier cet événement' : 'remettre cet événement en brouillon';
  if(!confirm('Confirmer : ' + action + ' ?')) return;

  b.disabled = true;

  try{
    const {error} = await sb
      .from('events')
      .update({status:nextStatus})
      .eq('id',id);

    if(error) throw error;

    await fetchRemote();
    setStatus('Statut de publication mis à jour.','ok');
  }catch(e){
    setStatus('Modification impossible : ' + e.message,'error');
  }finally{
    b.disabled = false;
  }
});

/* Supprimer un événement. */
$('adminList').addEventListener('click',async ev => {
  const b = ev.target.closest('[data-delete]');
  if(!b || !user || !isAdmin || !sb) return;

  if(!confirm('Supprimer définitivement cet événement ?')) return;

  b.disabled = true;

  try{
    const {error} = await sb
      .from('events')
      .delete()
      .eq('id',b.dataset.delete);

    if(error) throw error;

    await fetchRemote();
    setStatus('Événement supprimé.','ok');
  }catch(e){
    setStatus('Suppression impossible : ' + e.message,'error');
  }finally{
    b.disabled = false;
  }
});

/* Export réservé à la session administrateur. */
$('export').addEventListener('click',() => {
  if(!user || !isAdmin){
    setStatus('Action réservée aux administrateurs.','error');
    return;
  }

  const blob = new Blob([JSON.stringify(catalog,null,2)],{type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'fightagenda-catalogue.json';
  a.click();
  URL.revokeObjectURL(url);
});

['q','discipline','period'].forEach(id => {
  $(id).addEventListener(id === 'q' ? 'input' : 'change',render);
});

document.querySelector('.tabs').addEventListener('click',ev => {
  const b = ev.target.closest('[data-tab]');
  if(!b) return;

  activeTab = b.dataset.tab;
  document.querySelectorAll('.tab').forEach(x => {
    x.classList.toggle('active',x === b);
  });
  render();
});

$('reload').addEventListener('click',() => {
  if(sb) fetchRemote();
  else setSync('Supabase n’est pas connecté. Vérifie config.js.');
});

window.addEventListener('error',ev => {
  setSync('Erreur JavaScript : ' + (ev.message || 'erreur inconnue'));
});

window.addEventListener('unhandledrejection',ev => {
  const reason = ev.reason;
  setSync('Erreur JavaScript : ' + (reason && reason.message ? reason.message : String(reason || 'erreur inconnue')));
});

init();
})();
</script>
</body>
</html>
